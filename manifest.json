{
  "manifest_version": 3,
  "name": "YouTube Contemplatif",
  "version": "0.1.0",
  "description": "Un mode galerie contemplatif pour parcourir les chaînes YouTube d'ambiances et d'images générées.",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["gallery.css"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
